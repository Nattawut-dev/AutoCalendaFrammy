# LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-long-lived-channel-access-token

# Google AI Studio (model defaults to gemini-2.5-flash-lite if omitted)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Generate with: openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Comma-separated LINE user IDs permitted to use the bot
ALLOWED_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public deployed origin, without a trailing slash
APP_BASE_URL=https://your-project.vercel.app
